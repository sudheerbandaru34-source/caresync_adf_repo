{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-caresysnc"
		},
		"LS_ADLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlscaresyncprostorage.dfs.core.windows.net/"
		},
		"LS_AzureSqlDb_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "caresync-server-india.database.windows.net"
		},
		"LS_AzureSqlDb_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "free-sql-db-2743211"
		},
		"LS_AzureSqlDb_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sudheer404"
		},
		"LS_Comp_Databricks_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "0929-132927-g7juzezf"
		},
		"LS_Key_Vault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://caresync-keyvault-key.vault.azure.net/"
		},
		"LS_PostgreSql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-weathered-bonus-b3jlo7a8-pooler.c-4.ap-southeast-1.aws.neon.tech"
		},
		"LS_PostgreSql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"LS_PostgreSql_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-caresysnc_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLS_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_properties_typeProperties_url')]"
					},
					"LS_Key_Vault_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_Key_Vault_properties_typeProperties_baseUrl')]"
					},
					"LS_AzureSqlDb_properties_typeProperties_server": {
						"value": "[parameters('LS_AzureSqlDb_properties_typeProperties_server')]"
					},
					"LS_AzureSqlDb_properties_typeProperties_database": {
						"value": "[parameters('LS_AzureSqlDb_properties_typeProperties_database')]"
					},
					"LS_AzureSqlDb_properties_typeProperties_userName": {
						"value": "[parameters('LS_AzureSqlDb_properties_typeProperties_userName')]"
					},
					"LS_Comp_Databricks_properties_typeProperties_existingClusterId": {
						"value": "[parameters('LS_Comp_Databricks_properties_typeProperties_existingClusterId')]"
					},
					"LS_PostgreSql_properties_typeProperties_server": {
						"value": "[parameters('LS_PostgreSql_properties_typeProperties_server')]"
					},
					"LS_PostgreSql_properties_typeProperties_database": {
						"value": "[parameters('LS_PostgreSql_properties_typeProperties_database')]"
					},
					"LS_PostgreSql_properties_typeProperties_username": {
						"value": "[parameters('LS_PostgreSql_properties_typeProperties_username')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}